{
  "id": "anime-series",
  "name": "番剧",
  "icon": "📺",
  "description": "可以管理番剧和电视剧",
  "settingsKey": "anime",
  "defaultPageSize": 20,
  "resourceTypes": [
    "Anime"
  ],
  "showFolderVideosInDetail": true,
  "displayLayoutConfig": {
    "minWidth": 150,
    "maxWidth": 400
  },
  "sortOptions": [
    {
      "id": "name-asc",
      "label": "按名称排序",
      "field": "name",
      "order": "asc"
    },
    {
      "id": "name-desc",
      "label": "按名称排序（降序）",
      "field": "name",
      "order": "desc"
    },
    {
      "id": "addedDate-asc",
      "label": "按添加时间",
      "field": "addedDate",
      "order": "asc"
    },
    {
      "id": "addedDate-desc",
      "label": "按添加时间（降序）",
      "field": "addedDate",
      "order": "desc"
    }
  ],
  "emptyStateConfig": {
    "icon": "📺",
    "title": "你的番剧库是空的",
    "description": "点击\"添加番剧\"按钮来添加你的第一部番剧",
    "buttonText": "添加第一部番剧",
    "buttonAction": "showAddDialog"
  },
  "toolbarConfig": {
    "items": [
      {
        "type": "button",
        "label": "添加番剧",
        "action": "showAddDialog",
        "icon": "➕",
        "buttonType": "primary"
      },
      {
        "type": "button",
        "label": "批量导入本地资源",
        "action": "showBatchImportDialog",
        "icon": "📥"
      },
      {
        "type": "search",
        "placeholder": "搜索番剧...",
        "action": "filterBySearch"
      },
      {
        "type": "multi-select"
      },
      {
        "type": "layout"
      },
      {
        "type": "sort"
      }
    ]
  },
  "dialogConfig": {
    "addTitle": "添加番剧",
    "editTitle": "编辑番剧",
    "addButtonText": "添加番剧",
    "editButtonText": "保存修改"
  },
  "filterConfig": [
    {
      "key": "missing-resources",
      "title": "丢失的资源",
      "filterType": "missingResources",
      "params": {
        "missingLabel": "丢失的资源"
      }
    },
    {
      "key": "rating",
      "title": "星级筛选",
      "filterType": "rating",
      "params": {}
    },
    {
      "key": "tags",
      "title": "标签筛选",
      "filterType": "resourceField",
      "params": {
        "resource": "videoFolder",
        "field": "tags"
      },
      "isArray": true
    },
    {
      "key": "actors",
      "title": "演员筛选",
      "filterType": "resourceField",
      "params": {
        "resource": "videoFolder",
        "field": "actors"
      },
      "isArray": true
    },
    {
      "key": "series",
      "title": "系列筛选",
      "filterType": "resourceField",
      "params": {
        "resource": "videoFolder",
        "field": "series"
      },
      "isArray": false
    },
    {
      "key": "voiceActors",
      "title": "声优筛选",
      "filterType": "resourceField",
      "params": {
        "resource": "videoFolder",
        "field": "voiceActors"
      },
      "isArray": true
    },
    {
      "key": "productionTeam",
      "title": "制作组筛选",
      "filterType": "resourceField",
      "params": {
        "resource": "videoFolder",
        "field": "productionTeam"
      },
      "isArray": true
    }
  ],
  "acceptedKinds": [
    "videoFolder"
  ],
  "pageFields": [
    "name",
    "description",
    "series",
    "tags",
    "actors",
    "voiceActors",
    "productionTeam",
    "resourcePath",
    "thumbnail"
  ],
  "pageFieldDefs": [
    {
      "key": "name",
      "label": "游戏名",
      "editor": "text"
    },
    {
      "key": "description",
      "label": "游戏简介",
      "editor": "textarea"
    },
    {
      "key": "series",
      "label": "系列名",
      "editor": "text"
    },
    {
      "key": "tags",
      "label": "标签",
      "editor": "tags"
    },
    {
      "key": "actors",
      "label": "演员",
      "editor": "tags"
    },
    {
      "key": "voiceActors",
      "label": "声优",
      "editor": "tags"
    },
    {
      "key": "productionTeam",
      "label": "制作组",
      "editor": "tags"
    },
    {
      "key": "resourcePath",
      "label": "游戏路径",
      "editor": "file"
    },
    {
      "key": "thumbnail",
      "label": "缩略图",
      "editor": "cover"
    }
  ]
}