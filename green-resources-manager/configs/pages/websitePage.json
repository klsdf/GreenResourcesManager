{
  "id": "websites",
  "name": "网站",
  "icon": "🌐",
  "description": "可以管理网站，需要手动传入网址，也可以拖拽收藏夹进来",
  "settingsKey": "website",
  "defaultPageSize": 20,
  "resourceTypes": ["Website"],
  "displayLayoutConfig": {
    "minWidth": 150,
    "maxWidth": 400
  },
  "sortOptions": [
    { "id": "name-asc", "label": "按名称排序", "field": "name", "order": "asc" },
    { "id": "name-desc", "label": "按名称排序（降序）", "field": "name", "order": "desc" },
    { "id": "addedDate-asc", "label": "按添加时间（升序）", "field": "addedDate", "order": "asc" },
    { "id": "addedDate-desc", "label": "按添加时间（降序）", "field": "addedDate", "order": "desc" }
  ],
  "emptyStateConfig": {
    "icon": "🌐",
    "title": "你的网站库是空的",
    "description": "点击\"添加网站\"按钮来添加你的第一个网站",
    "buttonText": "添加第一个网站",
    "buttonAction": "showAddDialog"
  },
  "toolbarConfig": {
    "items": [
      {
        "type": "button",
        "label": "添加网站",
        "action": "showAddDialog",
        "icon": "➕",
        "buttonType": "primary"
      },
      {
        "type": "button",
        "label": "导入书签",
        "action": "showBookmarkImportDialog",
        "icon": "🔖"
      },
      {
        "type": "button",
        "label": "批量导入本地资源",
        "action": "showBatchImportDialog",
        "icon": "📥"
      },
      {
        "type": "search",
        "placeholder": "搜索网站...",
        "action": "filterBySearch"
      },
      {
        "type": "multi-select"
      },
      {
        "type": "layout"
      },
      {
        "type": "sort"
      }
    ]
  },
  "dialogConfig": {
    "addTitle": "添加网站",
    "editTitle": "编辑网站",
    "addButtonText": "添加网站",
    "editButtonText": "保存修改"
  },
  "filterConfig": [
    {
      "key": "missing-resources",
      "title": "丢失的资源",
      "filterType": "missingResources",
      "params": {
        "missingLabel": "丢失的资源"
      }
    },
    {
      "key": "tags",
      "title": "标签筛选",
      "filterType": "resourceField",
      "params": {
        "resource": "website",
        "field": "tags"
      },
      "isArray": true
    }
  ]
}